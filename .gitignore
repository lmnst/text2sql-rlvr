# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Secrets and local configuration
.env
.env.*
!.env.example

# Datasets, databases, and model artifacts. These are all *root-level* output
# directories, anchored with a leading slash so they never shadow a package
# directory deeper in the tree (e.g. src/text2sql_rlvr/data/).
/data/
*.sqlite
*.sqlite3
*.db
/checkpoints/
/models/
/wandb/
/outputs/
/logs/

# Internal working notes: kept locally, not published
/AGENTS.md
/HANDOFF.md
/docs/*
!/docs/.gitkeep
!/docs/data.md
!/docs/analysis/
/docs/analysis/*.md
/configs/checkpoints/README.md

# Generated experiment artifacts
results/*
!results/.gitkeep
!results/README.md
!results/runs.jsonl

